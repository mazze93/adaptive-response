{
  "name": "adaptive-response",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "dev:api": "pnpm --filter @adaptive-response/api dev",
    "dev:demo": "pnpm --filter @adaptive-response/demo dev",
    "test": "pnpm -r --filter './packages/**' --filter @adaptive-response/api test",
    "smoke": "node scripts/smoke.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "find . -name 'dist' -not -path '*/node_modules/*' | xargs rm -rf"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
