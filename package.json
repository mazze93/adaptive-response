{
  "name": "adaptive-response",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "dev:api": "pnpm --filter @adaptive/api dev",
    "dev:demo": "pnpm --filter @adaptive/demo dev",
    "test": "pnpm -r --filter './packages/**' --filter @adaptive/api test",
    "smoke": "node scripts/smoke.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "clean": "find . -name 'dist' -not -path '*/node_modules/*' | xargs rm -rf"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "undici": ">=8.9.0",
      "ws": ">=8.21.0",
      "postcss": ">=8.5.18",
      "@babel/core": ">=7.29.1",
      "vite": ">=6.4.3",
      "sharp": ">=0.35.0"
    }
  }
}
